@model Game106.Backend.ViewModel.RegisterVM
@{
    ViewData["Title"] = "Đăng ký Quản trị viên";
}
<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <h2 class="text-center mb-4">🚀 Đăng ký Admin Mới</h2>
        <form asp-action="Register">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="UserName" class="control-label">👤 Tài khoản</label>
                <input asp-for="UserName" class="form-control form-control-lg" placeholder="Nhập tài khoản admin..." />
                <span asp-validation-for="UserName" class="text-warning"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label">📧 Email</label>
                <input asp-for="Email" class="form-control form-control-lg" placeholder="admin@domain.com" />
                <span asp-validation-for="Email" class="text-warning"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Password" class="control-label">🔑 Mật khẩu</label>
                <input asp-for="Password" type="password" class="form-control form-control-lg" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-warning"></span>
            </div>
            <div class="form-group mb-4">
                <label asp-for="ConfirmPassword" class="control-label">🔑 Xác nhận MK</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control form-control-lg" placeholder="••••••••" />
                <span asp-validation-for="ConfirmPassword" class="text-warning"></span>
            </div>
            <div class="form-group d-grid">
                <input type="submit" value="Đăng ký ngay" class="btn btn-success btn-lg" />
            </div>
        </form>
    </div>
</div>
