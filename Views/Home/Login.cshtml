@model Game106.Backend.ViewModel.LoginVM
@{
    ViewData["Title"] = "Đăng nhập";
}
<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <h2 class="text-center mb-4">🔐 Đăng nhập Admin</h2>
        <form asp-action="Login">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="UserName" class="control-label">👤 Tài khoản</label>
                <input asp-for="UserName" class="form-control form-control-lg" placeholder="Nhập tài khoản admin..." />
                <span asp-validation-for="UserName" class="text-warning"></span>
            </div>
            <div class="form-group mb-4">
                <label asp-for="Password" class="control-label">🔑 Mật khẩu</label>
                <input asp-for="Password" type="password" class="form-control form-control-lg" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-warning"></span>
            </div>
            <div class="form-group d-grid">
                <input type="submit" value="Đăng nhập ngay" class="btn btn-primary btn-lg" />
            </div>
        </form>
    </div>
</div>
